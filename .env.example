# Переменные окружения для Chi Mall and NoS
# Скопируйте этот файл в .env и заполните значения

# Пароль для входа в админ-панель (/admin)
ADMIN_PASSWORD=china2024

# Путь к базе данных SQLite
# На Render с persistent disk: sqlite:////data/cars.db
# Локально: sqlite:///./cars.db  (по умолчанию)
DATABASE_URL=sqlite:///./cars.db
